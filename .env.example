MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER/test
ADMIN=NUMERO_CON_PREFIJO@c.us
BOT_PHONE=
PORT=3000
TIMEZONE=Europe/Madrid
# local conserva la sesión en AUTH_DATA_PATH. remote usa GridFS en MongoDB.
AUTH_STRATEGY=local
AUTH_DATA_PATH=.wwebjs_auth
# Si se omite, se deriva de BOT_PHONE; conservarlo al reiniciar o desplegar.
SESSION_ID=
REMOTE_BACKUP_MS=300000
# Ruta opcional a Chrome/Chromium del servidor; vacío usa el de Puppeteer.
PUPPETEER_EXECUTABLE_PATH=
# Solo activar cuando el entorno de alojamiento requiera Chrome sin sandbox.
PUPPETEER_NO_SANDBOX=false
# Mostrar stderr de Chrome para diagnosticar fallos al arrancar en el servidor.
PUPPETEER_DUMPIO=false
